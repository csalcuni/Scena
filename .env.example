# ---------------------------------------------------------------------------
# Scena — esempio di configurazione locale. Copia in `.env` e compila i valori.
# `.env` è ignorato da git e non deve mai contenere segreti committati.
# Questo file è letto solo dal proxy (tool/tmdb_proxy.js): dopo averlo
# modificato, riavvia il proxy. Flutter Web non legge `.env`.
# ---------------------------------------------------------------------------

# Token "API Read Access Token" (v4) di TMDB. Consigliato: resta solo sul proxy.
TMDB_BEARER_TOKEN=

# In alternativa puoi usare la API key v3. Se imposti il bearer token, questa
# viene ignorata.
TMDB_API_KEY=

# Proxy Node (tool/tmdb_proxy.js)
PORT=8787
HOST=127.0.0.1
# In sviluppo puoi lasciare `*`; in produzione indica l'origine esatta, ad es.
# https://scena.example.com
ALLOWED_ORIGIN=*

# ---------------------------------------------------------------------------
# Comandi Flutter (passare i valori con --dart-define, non hardcodarli)
# ---------------------------------------------------------------------------
# Demo offline con catalogo mock:
#   flutter run -d chrome --dart-define=USE_MOCK_TMDB=true
#
# Web con proxy locale (avviare prima `node tool/tmdb_proxy.js`):
#   flutter run -d chrome --dart-define=TMDB_PROXY_BASE_URL=http://localhost:8787
#
# Mobile con chiave diretta (solo per sviluppo; la chiave resta nel binario):
#   flutter run --dart-define=TMDB_API_KEY=la_tua_api_key_v3
#
# Lingua TMDB e durata episodio di fallback:
#   --dart-define=TMDB_LANGUAGE=it-IT
#   --dart-define=EPISODE_FALLBACK_MINUTES=45
